# Environment Configuration for InteractomeX Backend
# Scientific Research & Reproducibility Settings

PROJECT_NAME="InteractomeX AI Platform"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (Default: local SQLite database; replace with PostgreSQL in production)
# PostgreSQL format: postgresql+asyncpg://postgres:password@localhost:5432/interactomex
DATABASE_URL="sqlite+aiosqlite:///./interactomex.db"
DATABASE_SYNC_URL="sqlite:///./interactomex.db"

# Server Settings
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Reproducibility & Research Constraints
RANDOM_SEED=42
PYTORCH_SEED=42
NUMPY_SEED=42

# Hardware Optimization Profile: RTX 3050 (4GB VRAM) / 8GB RAM
DEVICE="cuda"
USE_FP16=true
FREEZE_ESM=true
BATCH_SIZE=16
MAX_SEQUENCE_LENGTH=1024
EMBEDDING_CACHE_DIR="./storage/embeddings"
CHECKPOINT_DIR="./storage/checkpoints"

# Evaluation & Splitting
DEFAULT_SPLIT_STRATEGY="random_stratified" # Options: random_stratified, protein_disjoint
STRICT_NEGATIVE_SAMPLING_RATIO=1.0 # 1:1 putative negative sampling
